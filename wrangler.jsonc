{
  "name": "siete-inventory",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parts",
      "database_id": "PASTE_YOUR_DATABASE_ID_HERE"
    }
  ]
}
